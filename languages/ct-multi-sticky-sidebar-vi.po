#. Plugin Name of the plugin
#: includes/admin.php:6
#: includes/admin.php:7
#: includes/admin.php:84
msgid "CT Multi Sticky Sidebar"
msgstr "CT Multi Sticky Sidebar"

#. Description of the plugin
msgid "Lightweight sticky sidebars for any number of sidebars per page. No jQuery, one static JS file per site, zero extra database queries on the frontend, nothing loaded on mobile or on pages without a sidebar. Powered by the Theia Sticky Sidebar v2 engine (MIT)."
msgstr "Sticky sidebar nhẹ, dùng cho bao nhiêu sidebar trên một trang cũng được. Không jQuery, mỗi site chỉ 1 file JS tĩnh, không thêm truy vấn database nào ở frontend, không tải gì trên mobile hay trên trang không có sidebar. Dùng lõi Theia Sticky Sidebar v2 (MIT)."

#: includes/admin.php:15
msgid "Settings"
msgstr "Cài đặt"

#: includes/admin.php:26
#: includes/admin.php:46
msgid "You do not have permission to do this."
msgstr "Bạn không có quyền thực hiện thao tác này."

#: includes/admin.php:66
#: includes/admin.php:67
msgid "global"
msgstr "chung"

#: includes/admin.php:68
msgid "Remove"
msgstr "Xóa"

#: includes/admin.php:87
msgid "Settings saved and the JS file regenerated."
msgstr "Đã lưu cấu hình và tạo lại file JS."

#: includes/admin.php:89
msgid "The JS file was regenerated from the current settings."
msgstr "Đã tạo lại file JS từ cấu hình hiện tại."

#. translators: 1: error code, 2: directory path
#: includes/admin.php:94
msgid "Could not generate the JS file (error code: %1$s). Check that %2$s is writable."
msgstr "Không tạo được file JS (mã lỗi: %1$s). Kiểm tra quyền ghi của thư mục %2$s."

#: includes/admin.php:99
msgid "Version 3.x adds \"Load the JS only where a sidebar is rendered\" and \"Do not load on\". Review them and click <strong>Save</strong> once to apply. Until then the plugin loads the JS on every page, like 2.x."
msgstr "Bản 3.x có thêm tùy chọn \"Chỉ nạp JS ở trang có sidebar\" và \"Không nạp trên\". Hãy kiểm tra rồi bấm <strong>Lưu</strong> một lần để áp dụng; trước khi lưu, plugin vẫn nạp JS ở mọi trang như bản 2.x."

#: includes/admin.php:106
msgid "Sidebars"
msgstr "Các sidebar"

#: includes/admin.php:107
msgid "Each row is one group: the sidebar CSS selector (several selectors can be separated by commas) and the CSS selector of the container it should stay inside. Leave a container empty to use the sidebar's parent element, and leave the margins empty to use the global values below."
msgstr "Mỗi dòng là một nhóm: selector sidebar (có thể nhiều selector cách nhau bằng dấu phẩy) và selector container chứa nó. Để trống container thì dùng phần tử cha của sidebar; để trống margin thì dùng giá trị chung bên dưới."

#: includes/admin.php:110
msgid "Sidebar CSS selector"
msgstr "Selector CSS của sidebar"

#: includes/admin.php:111
msgid "Container CSS selector"
msgstr "Selector CSS của container"

#: includes/admin.php:112
msgid "Top margin"
msgstr "Margin trên"

#: includes/admin.php:113
msgid "Bottom margin"
msgstr "Margin dưới"

#: includes/admin.php:120
msgid "+ Add sidebar"
msgstr "+ Thêm sidebar"

#: includes/admin.php:122
msgid "Global settings"
msgstr "Thông số chung"

#: includes/admin.php:124
msgid "Minimum width (px)"
msgstr "Chiều rộng tối thiểu (px)"

#: includes/admin.php:125
msgid "Below this viewport width the sidebar behaves normally."
msgstr "Màn hình hẹp hơn mức này thì sidebar trở lại bình thường."

#: includes/admin.php:126
msgid "Top margin (px)"
msgstr "Margin trên (px)"

#: includes/admin.php:128
msgid "Bottom margin (px)"
msgstr "Margin dưới (px)"

#: includes/admin.php:130
msgid "Sidebar behavior"
msgstr "Hành vi sidebar"

#: includes/admin.php:132
msgid "modern (recommended)"
msgstr "modern (khuyên dùng)"

#: includes/admin.php:136
msgid "modern: a sidebar taller than the screen sticks to the bottom while scrolling down and to the top while scrolling up, so every part of it can be read."
msgstr "modern: sidebar cao hơn màn hình sẽ dính đáy khi cuộn xuống và dính đỉnh khi cuộn lên, nên đọc được mọi phần của sidebar."

#: includes/admin.php:137
msgid "Update sidebar height"
msgstr "Cập nhật chiều cao sidebar"

#: includes/admin.php:138
msgid "Enable (updateSidebarHeight)"
msgstr "Bật (updateSidebarHeight)"

#: includes/admin.php:139
msgid "Stretch the sidebar to the container height (useful when the sidebar background or border looks cut off)."
msgstr "Kéo chiều cao sidebar bằng container (dùng khi nền/viền sidebar bị hụt)."

#: includes/admin.php:140
msgid "Disable on responsive layouts"
msgstr "Tắt khi layout responsive"

#: includes/admin.php:141
msgid "Enable (disableOnResponsiveLayouts)"
msgstr "Bật (disableOnResponsiveLayouts)"

#: includes/admin.php:142
msgid "Turn the sticky effect off when the sidebar drops below the content (sidebar almost as wide as its container)."
msgstr "Tự tắt sticky khi sidebar rơi xuống dưới nội dung (sidebar gần bằng chiều rộng container)."

#: includes/admin.php:145
msgid "Load the JS only where a sidebar is rendered"
msgstr "Chỉ nạp JS ở trang có sidebar"

#: includes/admin.php:146
msgid "Select the widget areas your sidebars use. The JS file is then loaded only when the template actually renders (<code>dynamic_sidebar()</code>) one of these areas and the area has widgets, so pages without a sidebar do not download it. <strong>No area selected = always load the JS.</strong>"
msgstr "Chọn các widget area mà sidebar của bạn hiển thị. Plugin chỉ nạp file JS khi template thực sự render (<code>dynamic_sidebar()</code>) một trong các vùng này và vùng đó có widget, nên trang không có sidebar sẽ không tải file JS. <strong>Không chọn vùng nào = luôn nạp JS.</strong>"

#: includes/admin.php:153
msgid "(no longer registered)"
msgstr "(không còn đăng ký)"

#: includes/admin.php:163
msgid "Do not load on"
msgstr "Không nạp trên"

#: includes/admin.php:165
msgid "Page types"
msgstr "Loại trang"

#: includes/admin.php:169
msgid "Home page / blog page (is_home, is_front_page)"
msgstr "Trang chủ / trang blog (is_home, is_front_page)"

#: includes/admin.php:170
msgid "Category archives (is_category)"
msgstr "Trang chuyên mục (is_category)"

#: includes/admin.php:171
msgid "Pages (is_page)"
msgstr "Trang tĩnh (is_page)"

#: includes/admin.php:172
msgid "Single posts (is_single)"
msgstr "Bài viết đơn (is_single)"

#: includes/admin.php:181
msgid "Save and regenerate the JS file"
msgstr "Lưu và tạo lại file JS"

#: includes/admin.php:185
msgid "Generated JS file"
msgstr "File JS đã tạo"

#. translators: 1: file size, 2: date and time
#: includes/admin.php:191
msgid "%1$s, last generated %2$s"
msgstr "%1$s, tạo lúc %2$s"

#: includes/admin.php:194
msgid "No file yet."
msgstr "Chưa có file."

#: includes/admin.php:194
msgid "Click the button below to create it."
msgstr "Bấm nút bên dưới để tạo."

#: includes/admin.php:200
msgid "Regenerate the JS file"
msgstr "Tạo lại file JS"

#: includes/admin.php:204
msgid "The plugin does not load anything on mobile devices (detected with <code>wp_is_mobile()</code>, tablets included). If your site uses a page cache, enable separate caches for mobile and desktop; otherwise the mobile HTML may be served to desktop visitors (no sticky sidebar) or the other way round."
msgstr "Plugin không nạp gì trên thiết bị di động (nhận biết bằng <code>wp_is_mobile()</code>, kể cả máy tính bảng). Nếu site dùng page cache, hãy bật tùy chọn tách cache cho mobile/desktop, nếu không HTML của mobile có thể được trả cho desktop (mất sticky) hoặc ngược lại."

#: includes/admin.php:205
msgid "After changing the settings, clear your page cache so pages pick up the new <code>?ver=</code>."
msgstr "Sau khi sửa cấu hình, xóa cache trang nếu có để trang nhận <code>?ver=</code> mới."

